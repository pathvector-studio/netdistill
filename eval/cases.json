{
  "description": "Fidelity eval cases. Each asks a question whose answer netdistill preserves (anomalies, inventory, presence/absence). Graders are deterministic: all must_contain substrings present AND no must_not_contain substrings present, case-insensitive.",
  "cases": [
    {
      "id": "bgp_down_peers",
      "fixture": "frr_bgp_summary.txt",
      "kind": "bgp-summary",
      "question": "Which BGP neighbors are NOT in the Established state? List their neighbor IP addresses.",
      "must_contain": ["10.0.16.2", "10.0.17.2"],
      "must_not_contain": ["10.0.12.2", "10.0.13.2"]
    },
    {
      "id": "bgp_total_peers",
      "fixture": "frr_bgp_summary.txt",
      "kind": "bgp-summary",
      "question": "How many BGP neighbors are configured in total? Answer with just the number.",
      "must_contain": ["8"],
      "must_not_contain": []
    },
    {
      "id": "ospf_stuck",
      "fixture": "ios_ospf_neighbors.txt",
      "kind": "ospf-neighbors",
      "question": "Which OSPF neighbor is stuck in the EXSTART state? Give its neighbor ID.",
      "must_contain": ["10.255.0.3"],
      "must_not_contain": []
    },
    {
      "id": "lldp_gi00_peer",
      "fixture": "ios_lldp_neighbors.txt",
      "kind": "lldp-neighbors",
      "question": "Which device is connected to local interface Gi0/0?",
      "must_contain": ["core-1"],
      "must_not_contain": []
    },
    {
      "id": "intf_crc_errors",
      "fixture": "ios_show_interfaces.txt",
      "kind": "interfaces",
      "question": "Which interface is showing a high number of CRC / input errors? Give the interface name.",
      "must_contain": ["0/1"],
      "must_not_contain": []
    },
    {
      "id": "intf_unexpected_down",
      "fixture": "ios_show_interfaces.txt",
      "kind": "interfaces",
      "question": "Which interface is DOWN but NOT administratively shut down? Give its name.",
      "must_contain": ["0/2"],
      "must_not_contain": ["0/3"]
    },
    {
      "id": "route_no_default",
      "fixture": "ios_route_vrf_all.txt",
      "kind": "route-table",
      "question": "Which routing table / VRF has NO default route (no gateway of last resort)?",
      "must_contain": ["MGMT"],
      "must_not_contain": []
    },
    {
      "id": "config_bgp_neighbors",
      "fixture": "ios_running_config.txt",
      "kind": "config",
      "question": "List the BGP neighbor IP addresses configured on this device.",
      "must_contain": ["10.0.12.2", "10.0.13.2"],
      "must_not_contain": []
    },
    {
      "id": "config_hostname",
      "fixture": "ios_running_config.txt",
      "kind": "config",
      "question": "What is the hostname of this device?",
      "must_contain": ["edge-tokyo-1"],
      "must_not_contain": []
    },
    {
      "id": "big_bgp_buried_down",
      "fixture": "big_bgp_ios_500.txt",
      "kind": "bgp-summary",
      "question": "Out of 500 BGP peers, which few are NOT in an Established state (shown as Active/Idle)? List their neighbor IP addresses.",
      "must_contain": ["10.20.1.7", "10.20.2.44", "10.20.4.19"],
      "must_not_contain": []
    },
    {
      "id": "xr_bgp_not_established",
      "fixture": "xr_bgp_summary.txt",
      "kind": "bgp-summary",
      "question": "Which BGP peer is NOT in the Established state? Give its IP address.",
      "must_contain": ["10.0.16.2"],
      "must_not_contain": ["10.0.14.2", "10.0.12.2"]
    },
    {
      "id": "eos_bgp_broken",
      "fixture": "eos_bgp_summary.txt",
      "kind": "bgp-summary",
      "question": "List the IP addresses of all BGP peers that are not in the Established state.",
      "must_contain": ["10.0.16.2", "10.0.17.2"],
      "must_not_contain": ["10.0.13.2"]
    },
    {
      "id": "vrp_bgp_broken",
      "fixture": "vrp_display_bgp_peer.txt",
      "kind": "bgp-summary",
      "question": "Which BGP peer is not in the Established state? Give its IP address.",
      "must_contain": ["10.0.16.2"],
      "must_not_contain": ["10.0.14.2"]
    },
    {
      "id": "nxos_no_default_route",
      "fixture": "nxos_show_ip_route.txt",
      "kind": "route-table",
      "question": "Which VRF has no default route (no gateway of last resort)?",
      "must_contain": ["management"],
      "must_not_contain": []
    },
    {
      "id": "junos_hidden_route",
      "fixture": "junos_show_route.txt",
      "kind": "route-table",
      "question": "Which routing table contains a hidden route?",
      "must_contain": ["inet.0"],
      "must_not_contain": []
    },
    {
      "id": "isis_stuck_adjacency",
      "fixture": "ios_isis_neighbors.txt",
      "kind": "isis-neighbors",
      "question": "Which IS-IS adjacency is stuck (state not UP)? Give its system-id.",
      "must_contain": ["edge-1"],
      "must_not_contain": []
    },
    {
      "id": "bgptable_top_origin_as",
      "fixture": "ios_show_ip_bgp.txt",
      "kind": "bgp-table",
      "question": "Which origin AS contributes the most best paths to the BGP table?",
      "must_contain": ["65010"],
      "must_not_contain": ["7018", "3356"]
    }
  ]
}
